<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:macro  name="robot_gazebo_sensors" params="robot_name">

        <gazebo>
            <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
                <ros>
                    <namespace>/${robot_name}</namespace>
                </ros>
                <!-- <parameters>$(find go2_description)/config/gaz_ros2_ctl_use_sim.yaml</parameters> -->
                <parameters>$(find go2_description)/config/ros_control.yaml</parameters>
            </plugin>
        </gazebo>


        <ros2_control name="${robot_name}_GazeboSystem" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>

            <!--
            initial_value on every position state_interface below: without
            this, every joint spawns at 0 (fully extended/straight, not a
            standing pose) and the IK gait controller commands its real
            0.25m-stance target (RobotController.py's default_height) from
            the very first control tick regardless, so position control
            snaps all 12 joints from 0 toward that very different target as
            fast as it can, all at once, while gravity is already acting on
            the body. That sudden, uneven whole-body reconfiguration was the
            real trigger behind this project's tip-over bug: live joint_states
            sampling this session showed the *commanded* stance was already
            correct and static within about 1s of spawn, yet the *body* kept
            visibly tipping for several more seconds afterward, because this
            idle stance has no active balance feedback at all (legs just hold
            a fixed angle relative to the trunk), so once that initial snap
            perturbs the body even slightly, nothing corrects it and physics
            alone finishes the fall. Spawning already in the target stance
            (paired with office_sim.launch.py's z_pose, empirically confirmed
            at 0.30; see its own comment for why that's not simply 0.25)
            means there's nothing to snap into and no disturbance to begin
            with. Confirmed live with both fixes together: settles to an
            essentially perfectly level pose within about 1-2s and stays
            rock solid.

            Values are this project's own live measurement, not guessed:
            forward-kinematics-verified joint angles for RobotController.py's
            actual default_stance at height=0.25, front legs (lf/rf) and
            rear/hind legs (lh/rh) differing slightly because of Robot.__init__'s
            own x_shift_front/x_shift_back offsets. If default_height in
            RobotController.py or the stance geometry in Robot.__init__ is
            ever retuned, these will need recomputing to match.
            -->
            <joint name="lf_hip_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="lf_upper_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.8614802851010153</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="lf_lower_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">-1.882620541626505</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <joint name="rf_hip_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="rf_upper_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.8614802851010153</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="rf_lower_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">-1.882620541626505</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <joint name="lh_hip_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="lh_upper_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.9436278382993397</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="lh_lower_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">-1.8872556765986797</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

            <joint name="rh_hip_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="rh_upper_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">0.9436278382993397</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="rh_lower_leg_joint">
                <command_interface name="position"/>
                <state_interface name="position"><param name="initial_value">-1.8872556765986797</param></state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
        </ros2_control>
        <gazebo reference="imu_link">
            <!--<material>Gazebo/Black</material>-->
            <gravity>false</gravity>
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>100</update_rate>
                <visualize>false</visualize>
                <topic>/${robot_name}/imu_plugin/out</topic>
                    <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu">
                </plugin>
                <pose>0 0 0 0 0 0</pose>
                <gz_frame_id>imu_link</gz_frame_id> <!-- Добавьте этот тег для указания кадра -->
                <!-- Real MEMS IMUs have both per-sample noise and a slowly-varying
                     bias, which is exactly what was missing before (see README's
                     FAST-LIO section: raw IMU data was bit-identical across the
                     whole init window with this sensor unconfigured, which is why
                     that bug's gravity-init bias could never be attributed to
                     sensor input). Values are gz-sim's own official sensor-noise
                     tutorial example
                     (github.com/osrf/gazebo_tutorials, sensor_noise/tutorial-7_0.md),
                     not this project's own measurement; a reasonable generic MEMS
                     IMU, not this sim's own hardware. bias_mean/bias_stddev sample
                     once at sim start and hold for the run (a real IMU's turn-on
                     bias), stddev is per-sample noise added continuously. -->
                <imu>
                    <angular_velocity>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev><bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
                        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
                        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

        <!-- Back-mounted 3D lidar, Livox Mid-360-style FOV (360 x 59 deg, -7..+52 deg
             elevation). gz-sim's gpu_lidar auto-publishes a flat multi-ring range array
             on <topic> (not useful once vertical samples > 1) AND a full point cloud on
             <topic>/points, which is what we actually consume. A separate 2D /scan for
             SLAM is produced downstream by pointcloud_to_laserscan, not by this sensor
             directly, hence "lidar" rather than "scan" as the topic base. -->
        <gazebo reference="laser_frame">
            <sensor name="lidar" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <visualize>false</visualize>
                <!-- 7, not 40/10: real MEMS/spinning lidars run well under their
                     datasheet peak rate once real-world constraints apply. -->
                <update_rate>7</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>900</samples>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>40</samples>
                            <min_angle>-0.12217</min_angle>  <!-- -7 deg -->
                            <max_angle>0.90757</max_angle>   <!-- +52 deg -->
                        </vertical>
                    </scan>
                    <range>
                        <min>0.10</min>
                        <!-- 15.0, not 40.0 (datasheet peak) or the previous 20.0:
                             Livox's own spec ("40m @ 10% reflectivity") is already
                             conservative for indoor surfaces (concrete/drywall run
                             15-90%+ reflectivity, per livoxtech.com), so the datasheet
                             number alone doesn't force a tight limit; 15.0 instead
                             matches nav2_params.yaml's own obstacle_max_range (both
                             local_costmap's voxel_layer and global_costmap's
                             obstacle_layer already cap observations at 15.0), so the
                             sensor's own range now agrees with what Nav2 actually
                             uses rather than reporting returns nothing downstream
                             looks at. Confirmed live: gz-sensors8's GpuLidarSensor
                             (unlike RgbdCameraSensor's depth clip, see the camera
                             sensor below) genuinely enforces this: rays beyond
                             <max> come back as literal +Inf, not silently-unclipped
                             finite values. -->
                        <max>15.0</max>
                    </range>
                    <!-- Livox Mid-360's own published range precision (1-sigma):
                         "<=2cm at 10m, <=3cm at 0.2m" (livoxtech.com/mid-360/specs).
                         A single Gaussian stddev can't reproduce that range
                         dependence exactly, so 0.02 (2cm) is the representative
                         value across this scene's ~0.1-20m range, same simplification
                         KISS-ICP's own position_covariance default already makes. -->
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.02</stddev>
                    </noise>
                </lidar>
                <topic>/${robot_name}/lidar</topic>
                <gz_frame_id>laser_frame</gz_frame_id>
            </sensor>
        </gazebo>

        <!-- Head-mounted RealSense D435-style RGBD camera, forward-facing (+X).
             gz-sim's rgbd_camera appends /image, /depth_image, /points, /camera_info
             to <topic>. -->
        <gazebo reference="camera_face">
            <sensor name="camera" type="rgbd_camera">
                <pose>0 0 0 0 0 0</pose>
                <visualize>true</visualize>
                <update_rate>15</update_rate>
                <camera>
                    <horizontal_fov>1.518</horizontal_fov>  <!-- 87 deg, D435 colour HFOV -->
                    <image>
                        <format>R8G8B8</format>
                        <width>848</width>
                        <height>480</height>
                    </image>
                    <!-- Left at the room-diagonal-covering 0.10/25.0, not narrowed to
                         a real D435's actual depth range (~0.3-3m, intel.com product
                         spec page): this is the SENSOR-WIDE clip, shared by the RGB
                         image, so narrowing it would also cut off the color /image at
                         3m, which a real D435's colour sensor has no such limit on.
                         depth_camera's own <clip> below is confirmed LIVE this
                         session to be a no-op: gz-sensors8's RgbdCameraSensor (this
                         project's exact gz-sim/Harmonic build) silently ignores it
                         for both /depth_image and /points; sampled facing open
                         floor with depth_camera clipped to 0.3/3.0 and this outer
                         clip left at 25.0, both topics kept returning finite values
                         out to ~9-12m regardless. Real depth-only range limiting
                         (and range-dependent noise, and edge smearing, neither of
                         which SDF has any tag for at all) would need a downstream
                         ROS node reprocessing the raw depth image/cloud, not
                         currently implemented; nothing consumes camera depth for
                         SLAM/Nav2 (lidar is the real range source, see README's
                         Architecture section), only RViz visualization. -->
                    <clip>
                        <near>0.10</near>
                        <far>25.0</far>
                    </clip>
                    <depth_camera>
                        <!-- <clip> deliberately omitted: confirmed live to be a
                             no-op on this build (see the outer <clip> comment
                             above), so leaving stale near/far numbers here would
                             misrepresent what's actually enforced. -->
                    </depth_camera>
                </camera>
                <topic>/${robot_name}/camera</topic>
                <gz_frame_id>camera_face</gz_frame_id>
            </sensor>
        </gazebo>


        <gazebo reference="trunk">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>

        <!-- <gazebo reference="stick_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo> -->

        <!-- <gazebo reference="imu_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo> -->

        <!-- FL leg -->
        <gazebo reference="lf_hip_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>

        </gazebo>
        <gazebo reference="lf_upper_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>
        <gazebo reference="lf_lower_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
        </gazebo>
        <gazebo reference="lf_foot_link">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>

        <!-- FR leg -->
        <gazebo reference="rf_hip">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo>
        <gazebo reference="rf_upper_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>
        <gazebo reference="rf_lower_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
        </gazebo>
        <gazebo reference="rf_foot_link">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>

        <!-- RL leg -->
        <gazebo reference="lh_hip">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo>
        <gazebo reference="lh_upper_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>
        <gazebo reference="lh_lower_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
        </gazebo>
        <gazebo reference="lh_foot_link">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>

        <!-- RR leg -->
        <gazebo reference="rh_hip">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo>
        <gazebo reference="rh_upper_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>
        <gazebo reference="rh_lower_leg_link">
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
            <self_collide>1</self_collide>
        </gazebo>
        <gazebo reference="rh_foot_link">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
            <self_collide>1</self_collide>
            <kp>10000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro >
</robot>
