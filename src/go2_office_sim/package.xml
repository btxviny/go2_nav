<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_office_sim</name>
  <version>0.1.0</version>
  <description>
    Autonomous frontier exploration of a Blender-generated office world with a
    Unitree Go2 in Gazebo Harmonic: RGBD camera + 3D lidar, slam_toolbox occupancy
    grid, Nav2, and rosbag recording of both sensors.
  </description>
  <maintainer email="viny@example.com">viny</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>go2_description</exec_depend>
  <exec_depend>gazebo_sim</exec_depend>
  <exec_depend>quadropted_controller</exec_depend>
  <exec_depend>quadropted_msgs</exec_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>spark_fast_lio</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
