Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /robot1/goal_pose
      # bt_navigator (nav_stack.launch.py, now namespaced under /robot1) has
      # a built-in "goal_pose" topic subscription that auto-forwards to a
      # NavigateToPose action call -- this is the standard way "2D Nav Goal"
      # works with Nav2, no nav2-specific rviz plugin needed.

  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot1/robot_description
      TF Prefix: ""

    - Class: rviz_default_plugins/PointCloud2
      Name: LidarPoints
      Enabled: false
      # Off by default now that FastLioGlobalMap below shows the same lidar data
      # accumulated into a real map -- flip this back on if you specifically
      # want to see raw single-scan points instead.
      Topic:
        Value: /robot1/lidar/points
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor

    - Class: rviz_default_plugins/Odometry
      Name: OdomTrajectory
      Enabled: true
      # Same display as office.rviz -- both backends publish the same real
      # /robot1/odom topic (see fast_lio.launch.py / kiss_icp.launch.py).
      #
      # Position Tolerance is larger than the axis length so consecutive
      # markers don't heavily overlap during normal driving.
      #
      # Covariance is explicitly disabled to avoid the yellow covariance
      # circles around every kept pose.
      Covariance:
        Value: false
      Topic:
        Value: /robot1/odom
      Keep: 40
      Position Tolerance: 0.2
      Angle Tolerance: 0.2
      Shape:
        Value: Axes
        Axes Length: 0.12
        Axes Radius: 0.015

    - Class: rviz_default_plugins/PointCloud2
      Name: FastLioGlobalMap
      Enabled: true
      # spark_fast_lio's own accumulated, voxel-deduplicated map -- a
      # flattened snapshot of its internal ikd_tree_ (the same structure it
      # uses for ICP correspondence search), republished as its own topic by
      # this project's publishGlobalMap() patch (see preprocess.h's GENERIC
      # lidar_type comment for the other go2_nav-specific patch in this
      # package). Named "global" rather than "local": fast_lio.yaml's
      # cube_side_length (60.0) is well larger than this ~20x20m office, so
      # this ends up holding everything explored so far rather than a small
      # window re-centered on the robot the way KISS-ICP's own kiss/local_map
      # is -- see office.rviz's KissIcpLocalMap for that equivalent.
      #
      # Only published when fast_lio.yaml's publish.global_map_pub_en is on.
      Topic:
        Value: /robot1/fastlio/global_map
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor

    - Class: rviz_default_plugins/Image
      Name: CameraColor
      Enabled: true
      # Image rendering is real CPU load RViz doesn't need to spend while
      # exploring (not used by SLAM/Nav2 at all, lidar-only).
      # Flip back on for camera debugging.
      Topic:
        Value: /robot1/camera/image

    - Class: rviz_default_plugins/Image
      Name: CameraDepth
      Enabled: true
      Topic:
        Value: /robot1/camera/depth_image
      # Fixed range instead of auto-normalize: rays past the 25m far clip
      # can return +Inf and otherwise wash out the entire depth display.
      Normalize Range: false
      Min Value: 0.0
      Max Value: 25.0

    - Class: rviz_default_plugins/PointCloud2
      Name: CameraPoints
      Enabled: false
      Topic:
        Value: /robot1/camera/points
      Size (m): 0.01
      Style: Points
      Color Transformer: RGB8

    - Class: rviz_default_plugins/LaserScan
      Name: Scan2D
      Enabled: true
      Topic:
        Value: /robot1/scan
      Size (m): 0.05
      Color: 255; 0; 0

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: false
      Topic:
        Value: /robot1/map

    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Enabled: true
      Topic:
        Value: /robot1/global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5

    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: false
      Topic:
        Value: /robot1/local_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.5

    - Class: rviz_default_plugins/Path
      Name: GlobalPlan
      Enabled: true
      Topic:
        Value: /robot1/plan
      Color: 0; 255; 0

    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /robot1/local_costmap/published_footprint
      Color: 255; 255; 0

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: -5
        Z: 0
      Pitch: 0.6
      Yaw: 1.0

Window Geometry:
  Height: 900
  Width: 1500
